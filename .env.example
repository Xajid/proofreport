# Local Postgres (published Cursor apps inject DATABASE_URL automatically)
DATABASE_URL="postgresql://user:pass@localhost:5432/searchproof"
NEXTAUTH_URL="https://getsearchproof.com"
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXT_PUBLIC_DEMO_MODE="true"

# Optional. NVIDIA is used first when both keys exist, so tests do not spend OpenAI tokens.
# AI_PROVIDER=nvidia | openai | template
NVIDIA_API_KEY=
NVIDIA_MODEL="nvidia/nemotron-3.5-bolt-e4b"
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Billing (Dodo Payments)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENV="test_mode" # "test_mode" or "live_mode"
DODO_PRODUCT_PER_CLIENT=
DODO_PRODUCT_AGENCY=
RESEND_API_KEY=
EMAIL_FROM="SearchProof <info@getsearchproof.com>"
# Required. Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=
ADMIN_EMAIL="demo@getsearchproof.com"
